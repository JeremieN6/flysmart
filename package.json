{
  "name": "flysmart",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "validate-delta": "node --experimental-strip-types --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/validate-price-delta.ts",
